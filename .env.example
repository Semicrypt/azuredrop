NODE_ENV=development

PORT=5000

POSTGRES_DB=azuredrop
POSTGRES_USER=azuredrop
POSTGRES_PASSWORD=change-this-password

DATABASE_URL=postgresql://azuredrop:change-this-password@postgres:5432/azuredrop

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

MAX_FILE_SIZE_MB=10

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=azuredrop-files

# Local development only.
# Will be used with Azurite later.
AZURE_STORAGE_CONNECTION_STRING=

AZURE_STORAGE_PUBLIC_BLOB_ENDPOINT=http://localhost:10000/devstoreaccount1